rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasActiveSubscription() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/subscriptions/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/subscriptions/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/subscriptions/$(request.auth.uid)).data.expiryDate > request.time;
    }

    // Private learning files are readable only by an active subscriber or admin.
    match /learning_materials/{allPaths=**} {
      allow read: if isAdmin() || hasActiveSubscription();
      allow write: if isAdmin()
        && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }

    // Students may manage only their own profile images.
    match /profile_images/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn()
        && request.auth.uid == userId
        && (request.resource == null || request.resource.size < 5 * 1024 * 1024);
    }
  }
}
